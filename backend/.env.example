# Database
DATABASE_URL=sqlite:///./aveness.db

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin credentials (change these!)
ADMIN_EMAIL=admin@avenessllc.com
ADMIN_PASSWORD=change-this-password

# Email (Resend) - leave RESEND_API_KEY unset to disable email sending locally
RESEND_API_KEY=
EMAIL_FROM=noreply@jasparkle.org
